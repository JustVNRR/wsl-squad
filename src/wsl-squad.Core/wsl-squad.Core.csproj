<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>WslSquad.Core</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>$(NoWarn);CA1822;S2325;IDE0032;S2292;S4144;IDE0019;IDE0017;IDE0047;S3267;S1075;S2589;IDE0045;CA1859</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\Assets\packs\**\*"
                            LogicalName="packs/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\Assets\ingredients\**\*"
                            LogicalName="ingredients/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\Assets\recipes\**\*"
                            LogicalName="recipes/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\Assets\fonts\**\*.ttf"
                            LogicalName="fonts/%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\Assets\languages\**\*.json"
                            LogicalName="languages/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="wsl-squad.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
        <PackageReference Include="System.IO.Abstractions" Version="22.3.0" />
    </ItemGroup>

</Project>
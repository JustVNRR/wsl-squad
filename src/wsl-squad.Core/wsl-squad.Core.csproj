<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>wsl_squad.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scripts Linux embarqués dans la DLL -->
    <EmbeddedResource Include="Resources\Linux\**\*.*" />
    <EmbeddedResource Include="Resources\recipes\**\*" />
    <!-- Polices partagées depuis /Assets, également embarquées dans la DLL de Core -->
    <EmbeddedResource Include="..\..\Assets\fonts\**\*.ttf" Link="Resources\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
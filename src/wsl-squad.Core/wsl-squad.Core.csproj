<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>wsl_squad.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scripts Linux embarqués dans la DLL -->
    <EmbeddedResource Include="Resources\Linux\**\*.*" LogicalName="linux/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\recipes\**\*" LogicalName="recipes/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Polices partagées depuis /Assets, également embarquées dans la DLL de Core -->
    <EmbeddedResource Include="..\..\Assets\fonts\**\*.ttf" LogicalName="fonts/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="System.IO.Abstractions" Version="22.3.0" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\wsl-squad.Presentation\wsl-squad.Presentation.csproj" />
    <ProjectReference Include="..\wsl-squad.UI.Cli\wsl-squad.UI.Cli.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Resource Include="..\..\Assets\fonts\**\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <Target Name="CopyCli" AfterTargets="Build">
    <ItemGroup>
      <CliFiles Include="$(CliOutputDir)**\*" Exclude="$(CliOutputDir)win-x64\**\*" />
    </ItemGroup>
    <Error Condition="!Exists('$(CliOutputDir)wsl-squad.cli.dll')" Text="The CLI is missing: $(CliOutputDir). Build wsl-squad.UI.Cli first." />
    <RemoveDir Directories="$(OutDir)cli" />
    <Copy SourceFiles="@(CliFiles)" DestinationFiles="@(CliFiles->'$(OutDir)cli\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCliOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <CliFiles Include="$(CliOutputDir)**\*" Exclude="$(CliOutputDir)win-x64\**\*" />
    </ItemGroup>
    <Error Condition="!Exists('$(CliOutputDir)wsl-squad.cli.dll')" Text="The CLI is missing: $(CliOutputDir). Build wsl-squad.UI.Cli first." />
    <RemoveDir Directories="$(PublishDir)cli" />
    <Copy SourceFiles="@(CliFiles)" DestinationFiles="@(CliFiles->'$(PublishDir)cli\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <CliOutputDir>$(RepositoryRoot)artifacts\bin\wsl-squad.UI.Cli\$(Configuration)\net10.0\</CliOutputDir>
    <RootNamespace>WslSquad.UI.Wpf</RootNamespace>
    <AssemblyName>wsl-squad.gui</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);S6605;IDE0017;IDE0305;IDE0270;S3267;CA1869</NoWarn>
  </PropertyGroup>
</Project>

<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.Dialogs.ErrorWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    xmlns:loc="clr-namespace:WslSquad.Presentation.Localization;assembly=wsl-squad.Presentation"
                    Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ErrorTitle]}"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppDangerBrush}"/>
        <TextBlock Text="{Binding Stamp}" Margin="0,10,0,0" Foreground="{DynamicResource AppMutedBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionOk]}" IsDefault="True" IsCancel="True"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

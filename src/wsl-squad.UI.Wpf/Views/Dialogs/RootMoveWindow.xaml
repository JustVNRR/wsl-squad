<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Dialogs.RootMoveWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="WSL SQUAD"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding Warning}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppWarningBrush}"/>
        <TextBox x:Name="TxtNewRoot" Text="{Binding NewRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"
                 Background="{DynamicResource AppInputBackgroundBrush}"
                 Foreground="{DynamicResource AppForegroundBrush}"
                 BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="CONFIRM" IsDefault="True" Command="{Binding ConfirmCommand}"
                    Style="{DynamicResource BtnDelete}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

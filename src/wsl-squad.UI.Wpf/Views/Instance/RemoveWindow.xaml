<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.Instance.RemoveWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    xmlns:loc="clr-namespace:WslSquad.Presentation.Localization;assembly=wsl-squad.Presentation"
                    Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[RemoveInstanceTitle]}"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningPermanentDestruction]}" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}"/>
        <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningRemoveDestroy]}"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningRemoveInstallFolder]}"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningRemoveVirtualDisk]}"/>
        <TextBlock Margin="0,10,0,10" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningRemoveCannotUndo]}"/>
        <CheckBox x:Name="ChkArchive" IsChecked="{Binding ArchiveFirst, Mode=TwoWay}" TabIndex="0" Margin="0,12,0,0" Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[OptionArchiveFirst]}"/>
        <TextBlock Margin="0,14,0,10" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelTypedInstance]}"/>
        <TextBox x:Name="TxtName" Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" TabIndex="1" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionCancel]}" TabIndex="2" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionRemove]}" TabIndex="3" IsDefault="True" Command="{Binding ConfirmCommand}"
                    Style="{DynamicResource BtnDelete}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

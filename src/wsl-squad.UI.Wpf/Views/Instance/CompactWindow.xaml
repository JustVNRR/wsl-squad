<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Instance.CompactWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="Compact instance"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <TextBlock Margin="0,10,0,0" Text="WARNING: THE INSTANCE WILL BE STOPPED." FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}"/>
        <TextBlock Margin="0,10,0,10" TextWrapping="Wrap">Make sure nothing is running inside.</TextBlock>
        <CheckBox x:Name="ChkArchive" IsChecked="{Binding ArchiveFirst, Mode=TwoWay}" TabIndex="0" Margin="0,12,0,0" Content="Archive it first"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" TabIndex="1" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="COMPACT" TabIndex="2" IsDefault="True" Command="{Binding ConfirmCommand}"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

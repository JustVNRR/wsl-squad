<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.Instance.CompactWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    xmlns:loc="clr-namespace:WslSquad.Presentation.Localization;assembly=wsl-squad.Presentation"
                    Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[CompactInstanceTitle]}"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningInstanceStopped]}" FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}"/>
        <TextBlock Margin="0,10,0,10" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningNothingRunning]}"/>
        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"
                   Visibility="{Binding ReplacesArchive, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[WarningArchiveReplaced]}"/>
        <CheckBox x:Name="ChkArchive" IsChecked="{Binding ArchiveFirst, Mode=TwoWay}" TabIndex="0" Margin="0,12,0,0" Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[OptionArchiveFirst]}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionCancel]}" TabIndex="1" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionCompact]}" TabIndex="2" IsDefault="True" Command="{Binding ConfirmCommand}"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

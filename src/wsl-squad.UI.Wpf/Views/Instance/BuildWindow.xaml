<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.Instance.BuildWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    xmlns:loc="clr-namespace:WslSquad.Presentation.Localization;assembly=wsl-squad.Presentation"
                    xmlns:vm="clr-namespace:WslSquad.Presentation.Gui.ViewModels;assembly=wsl-squad.Presentation"
                    Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[AddInstanceTitle]}"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,18,18,4">
                <TextBlock Text="{Binding Lead}" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelInstanceName]}"/>
                <TextBox x:Name="TxtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding NameError}" Visibility="{Binding NameError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                <StackPanel Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelUserName]}" IsEnabled="{Binding RunOnboarding}"/>
                    <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RunOnboarding}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding UserError}" Visibility="{Binding UserError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelBuildFrom]}"/>
                <ComboBox SelectedIndex="{Binding RoadIndex, Mode=TwoWay}" Margin="0,6,0,0">
                    <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[BuildRoadImage]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[BuildRoadRecipe]}"/>
                </ComboBox>
                <StackPanel Visibility="{Binding ShowImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelDockerImage]}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ImageNames}" SelectedIndex="{Binding ImageIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipUploadImage]}" Command="{Binding UploadImageCommand}"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadImage}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipSaveImage]}" Command="{Binding DownloadImageCommand}"/>
                        <Button Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashImage}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDeleteSource]}" Command="{Binding DeleteSelectedCommand}" CommandParameter="{x:Static vm:WslCatalogSection.DockerImages}"/>
                    </Grid>
                    <TextBlock Text="{Binding ImageError}" Visibility="{Binding ImageError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowRecipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelRecipe]}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding RecipeNames}" SelectedIndex="{Binding RecipeIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF067;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipCreateRecipe]}" Command="{Binding NewRecipeCommand}"/>
                        <Button Grid.Column="2" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipOpenRecipe]}" Command="{Binding EditSourceCommand}" CommandParameter="{x:Static vm:WslCatalogSection.Recipes}"/>
                        <Button Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashRecipe}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDeleteRecipe]}" Command="{Binding DeleteSelectedCommand}" CommandParameter="{x:Static vm:WslCatalogSection.Recipes}"/>
                    </Grid>
                    <TextBlock Text="{Binding RecipeError}" Visibility="{Binding RecipeError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <CheckBox Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[OptionSaveImage]}" IsChecked="{Binding SaveImage, Mode=TwoWay}" Margin="0,10,0,0"
                          Visibility="{Binding ShowSaveImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <CheckBox Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[OptionRegisterDocker]}" IsChecked="{Binding RegisterDocker, Mode=TwoWay}" Margin="0,12,0,0"
                          Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <CheckBox Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[OptionRunOnboarding]}" IsChecked="{Binding RunOnboarding, Mode=TwoWay}" Margin="0,12,0,0"
                          Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel IsEnabled="{Binding RunOnboarding}"
                            Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelOnboarding]}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding OnboardingNames}" SelectedIndex="{Binding OnboardingIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipUploadOnboarding]}" Command="{Binding UploadOnboardingCommand}"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadOnboarding}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipSaveOnboarding]}" Command="{Binding DownloadOnboardingCommand}"/>
                        <Button Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipEditOnboarding]}" Command="{Binding EditSourceCommand}" CommandParameter="{x:Static vm:WslCatalogSection.Onboardings}"/>
                        <Button Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashOnboarding}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDeleteSource]}" Command="{Binding DeleteSelectedCommand}" CommandParameter="{x:Static vm:WslCatalogSection.Onboardings}"/>
                    </Grid>
                    <TextBlock Text="{Binding OnboardingError}" Visibility="{Binding OnboardingError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,16">
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionCancel]}" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionCreate]}" IsDefault="True" Command="{Binding CreateCommand}"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </Grid>
</views:ChromeWindow>

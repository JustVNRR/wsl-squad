<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Instance.BuildWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="Add instance"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,18,18,4">
                <TextBlock Text="{Binding Lead}" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                <TextBlock Margin="0,10,0,0" Text="Instance name:"/>
                <TextBox x:Name="TxtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                <TextBlock x:Name="GuiNameError" Text="{Binding NameError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                <TextBlock x:Name="LblUser" Margin="0,12,0,0" Text="User name:" IsEnabled="{Binding RunOnboarding}"/>
                <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RunOnboarding}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                <TextBlock x:Name="GuiUserError" Text="{Binding UserError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                <TextBlock Margin="0,12,0,0" Text="Build from:"/>
                <ComboBox SelectedIndex="{Binding RoadIndex, Mode=OneWay}" SelectionChanged="OnRoadSelected" Margin="0,6,0,0">
                    <ComboBoxItem Content="Dockerfile"/>
                    <ComboBoxItem Content="Docker image"/>
                    <ComboBoxItem Content="Docker registry"/>
                    <ComboBoxItem Content="Recipe"/>
                </ComboBox>
                <StackPanel Visibility="{Binding ShowDockerfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Dockerfile:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding DockerfileNames}" SelectedIndex="{Binding DockerfileIndex, Mode=OneWay}" SelectionChanged="OnDockerfileSelected" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload a Dockerfile..." Click="OnUploadDockerfile"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadDockerfile}" ToolTip="Save the selected Dockerfile..." Click="OnDownloadDockerfile"/>
                        <Button Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the selected Dockerfile in the code editor" Click="OnEditDockerfile"/>
                        <Button Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashDockerfile}" ToolTip="Delete the selected uploaded file" Click="OnDeleteSource" Tag="Dockerfiles"/>
                    </Grid>
                    <CheckBox Content="Save image locally" IsChecked="{Binding SaveImage, Mode=TwoWay}" Margin="0,10,0,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Docker image:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ImageNames}" SelectedIndex="{Binding ImageIndex, Mode=OneWay}" SelectionChanged="OnImageSelected" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload an image (.tar)..." Click="OnUploadImage"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadImage}" ToolTip="Save the selected Docker image..." Click="OnDownloadImage"/>
                        <Button Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashImage}" ToolTip="Delete the selected uploaded file" Click="OnDeleteSource" Tag="DockerImages"/>
                    </Grid>
                    <TextBlock x:Name="GuiImageError" Text="{Binding ImageError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowRegistry, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Registry image:"/>
                    <TextBox Text="{Binding RegistryRef, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                    <TextBlock x:Name="GuiRegistryError" Text="{Binding RegistryError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowRecipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Recipe:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding RecipeNames}" SelectedIndex="{Binding RecipeIndex, Mode=OneWay}" SelectionChanged="OnRecipeSelected" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF067;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Create a recipe..." Click="OnNewRecipe"/>
                        <Button Grid.Column="2" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Open the recipe's folder in the code editor" Click="OnEditRecipe"/>
                        <Button Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashRecipe}" ToolTip="Delete the selected recipe" Click="OnDeleteSource" Tag="Recipes"/>
                    </Grid>
                    <TextBlock x:Name="GuiRecipeError" Text="{Binding RecipeError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                    <CheckBox Content="Save image locally" IsChecked="{Binding SaveImage, Mode=TwoWay}" Margin="0,10,0,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                </StackPanel>
                <CheckBox Content="Add Docker Desktop support (will be restarted)" IsChecked="{Binding RegisterDocker, Mode=TwoWay}" Margin="0,12,0,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                <CheckBox Content="Run onboarding shell" IsChecked="{Binding RunOnboarding, Mode=TwoWay}" Margin="0,12,0,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                <StackPanel IsEnabled="{Binding RunOnboarding}">
                    <TextBlock Margin="0,10,0,0" Text="Onboarding:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding OnboardingNames}" SelectedIndex="{Binding OnboardingIndex, Mode=OneWay}" SelectionChanged="OnOnboardingSelected" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload onboarding shell..." Click="OnUploadOnboarding"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadOnboarding}" ToolTip="Save the selected onboarding shell..." Click="OnDownloadOnboarding"/>
                        <Button Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the selected onboarding shell in the code editor" Click="OnEditOnboarding"/>
                        <Button Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashOnboarding}" ToolTip="Delete the selected uploaded file" Click="OnDeleteSource" Tag="Onboardings"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,16">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
            <Button Content="CREATE" IsDefault="True" Command="{Binding CreateCommand}"
                    Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
        </StackPanel>
    </Grid>
</views:ChromeWindow>

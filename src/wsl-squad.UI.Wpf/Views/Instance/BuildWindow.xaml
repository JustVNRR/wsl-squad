<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.Instance.BuildWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    Title="Add instance"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,18,18,4">
                <TextBlock Text="{Binding Lead}" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                <TextBlock Margin="0,10,0,0" Text="Instance name:"/>
                <TextBox x:Name="TxtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                <TextBlock Text="{Binding NameError}" Visibility="{Binding NameError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                <TextBlock Margin="0,12,0,0" Text="User name:" IsEnabled="{Binding RunOnboarding}"/>
                <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RunOnboarding}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                <TextBlock Text="{Binding UserError}" Visibility="{Binding UserError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                <TextBlock Margin="0,12,0,0" Text="Build from:"/>
                <ComboBox SelectedIndex="{Binding RoadIndex, Mode=TwoWay}" Margin="0,6,0,0">
                    <ComboBoxItem Content="Dockerfile"/>
                    <ComboBoxItem Content="Docker image"/>
                    <ComboBoxItem Content="Docker registry"/>
                    <ComboBoxItem Content="Recipe"/>
                </ComboBox>
                <StackPanel Visibility="{Binding ShowDockerfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Dockerfile:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding DockerfileNames}" SelectedIndex="{Binding DockerfileIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload a Dockerfile..." Command="{Binding UploadDockerfileCommand}"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadDockerfile}" ToolTip="Save the selected Dockerfile..." Command="{Binding DownloadDockerfileCommand}"/>
                        <Button Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the selected Dockerfile in the code editor" Command="{Binding EditSourceCommand}" CommandParameter="Dockerfiles"/>
                        <Button Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashDockerfile}" ToolTip="Delete the selected uploaded file" Command="{Binding DeleteSelectedCommand}" CommandParameter="Dockerfiles"/>
                    </Grid>
                    <TextBlock Text="{Binding DockerfileError}" Visibility="{Binding DockerfileError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                    <CheckBox Content="Save image locally" IsChecked="{Binding SaveImage, Mode=TwoWay}" Margin="0,10,0,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Docker image:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ImageNames}" SelectedIndex="{Binding ImageIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload an image (.tar)..." Command="{Binding UploadImageCommand}"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadImage}" ToolTip="Save the selected Docker image..." Command="{Binding DownloadImageCommand}"/>
                        <Button Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashImage}" ToolTip="Delete the selected uploaded file" Command="{Binding DeleteSelectedCommand}" CommandParameter="DockerImages"/>
                    </Grid>
                    <TextBlock Text="{Binding ImageError}" Visibility="{Binding ImageError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowRegistry, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Registry image:"/>
                    <TextBox Text="{Binding RegistryRef, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                    <TextBlock Text="{Binding RegistryError}" Visibility="{Binding RegistryError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowRecipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Recipe:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding RecipeNames}" SelectedIndex="{Binding RecipeIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF067;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Create a recipe..." Command="{Binding NewRecipeCommand}"/>
                        <Button Grid.Column="2" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Open the recipe's folder in the code editor" Command="{Binding EditSourceCommand}" CommandParameter="Recipes"/>
                        <Button Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashRecipe}" ToolTip="Delete the selected recipe" Command="{Binding DeleteSelectedCommand}" CommandParameter="Recipes"/>
                    </Grid>
                    <TextBlock Text="{Binding RecipeError}" Visibility="{Binding RecipeError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <CheckBox Content="Add Docker Desktop support (will be restarted)" IsChecked="{Binding RegisterDocker, Mode=TwoWay}" Margin="0,12,0,0" Foreground="{DynamicResource AppForegroundBrush}"
                          Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <CheckBox Content="Run onboarding shell" IsChecked="{Binding RunOnboarding, Mode=TwoWay}" Margin="0,12,0,0" Foreground="{DynamicResource AppForegroundBrush}"
                          Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel IsEnabled="{Binding RunOnboarding}"
                            Visibility="{Binding ShowGeneralOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,10,0,0" Text="Onboarding:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding OnboardingNames}" SelectedIndex="{Binding OnboardingIndex, Mode=TwoWay}" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload onboarding shell..." Command="{Binding UploadOnboardingCommand}"/>
                        <Button Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadOnboarding}" ToolTip="Save the selected onboarding shell..." Command="{Binding DownloadOnboardingCommand}"/>
                        <Button Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the selected onboarding shell in the code editor" Command="{Binding EditSourceCommand}" CommandParameter="Onboardings"/>
                        <Button Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashOnboarding}" ToolTip="Delete the selected uploaded file" Command="{Binding DeleteSelectedCommand}" CommandParameter="Onboardings"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,16">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
            <Button Content="CREATE" IsDefault="True" Command="{Binding CreateCommand}"
                    Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
        </StackPanel>
    </Grid>
</views:ChromeWindow>

<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Instance.DockerRegisterWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="Docker Desktop"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <CheckBox IsChecked="{Binding Restart, Mode=TwoWay}" Margin="0,14,0,0"
                  Content="Restart Docker Desktop to apply now."
                  Foreground="{DynamicResource AppForegroundBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="APPLY" IsDefault="True" Command="{Binding ConfirmCommand}"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

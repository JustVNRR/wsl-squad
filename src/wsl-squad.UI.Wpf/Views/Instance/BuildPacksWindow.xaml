<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Instance.BuildPacksWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="Packs for the build"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,18,18,4">
                <TextBlock x:Name="TxtPacksTitle" FontWeight="SemiBold"/>
                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                <TextBlock x:Name="TxtPacksForeign" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppWarningBrush}" Visibility="Collapsed"
                           Text="The recipe's system cannot be read.&#10;Please make sure your Docker image is compatible with the following packs before ticking them."/>
                <ScrollViewer MaxHeight="260" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Boxes"/>
                </ScrollViewer>
                <TextBlock x:Name="TxtNotes" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,16">
            <Button x:Name="BtnPickCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
            <Button x:Name="BtnPickApply" Content="APPLY" IsDefault="True"
                    Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
        </StackPanel>
    </Grid>
</views:ChromeWindow>

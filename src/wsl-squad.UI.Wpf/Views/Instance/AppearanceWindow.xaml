<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Instance.AppearanceWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="Appearance"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                    <TextBlock Margin="0,12,0,0" Text="Icon text:"/>
                    <TextBox x:Name="TxtIconText" Text="{Binding IconText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" HorizontalAlignment="Left"
                             Background="{DynamicResource AppInputBackgroundBrush}"
                             Foreground="{DynamicResource AppForegroundBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                    <TextBlock x:Name="GuiIconError" Text="{Binding IconError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Top" Margin="14,0,0,0" Width="64" Height="64">
                    <Border x:Name="BrdTile" CornerRadius="13" Width="60" Height="60"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="#333333"/>
                    <TextBlock x:Name="TxtTile" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34"/>
                    <Image x:Name="ImgIconPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Margin="0,10,0,0" Text="Icon color:"/>
                    <ComboBox x:Name="LstPairs" ItemsSource="{Binding PairLabels}" SelectedIndex="{Binding PairIndex, Mode=TwoWay}" Margin="0,6,0,0"/>
                    <TextBlock Margin="0,10,0,0" Text="Icon file:"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtImagePath" Grid.Column="0" Text="{Binding ImagePath}" ToolTip="{Binding ImagePath}"
                                   Foreground="{DynamicResource AppMutedBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnImage" Grid.Column="1" Content="Upload"
                                Background="{DynamicResource AppFaceBrush}"
                                Foreground="{DynamicResource AppForegroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"/>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" Text="Font:"/>
                    <ComboBox x:Name="LstFonts" ItemsSource="{Binding FontLabels}" SelectedIndex="{Binding FontIndex, Mode=TwoWay}" Margin="0,6,0,0"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AppMutedBrush}"
                               Text="Get more Nerd Fonts at https://www.nerdfonts.com"/>
                    <TextBlock Margin="0,14,0,0" Text="Colour scheme:"/>
                    <ComboBox x:Name="LstSchemes" ItemsSource="{Binding SchemeLabels}" SelectedIndex="{Binding SchemeIndex, Mode=TwoWay}" Margin="0,6,0,0"/>
                    <TextBlock Margin="0,14,0,0" Text="Preview:"/>
                    <Border x:Name="BrdPreview" Margin="0,6,0,0" Padding="8,6" CornerRadius="3"
                            Background="#0C0C0C" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtPreview1" FontFamily="Consolas">
                                <Run Tag="c3" Text="[~/projects]" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview2" FontFamily="Consolas">
                                <Run Tag="c5" Text="&#xF126; main " FontWeight="Bold"/>
                                <Run Tag="c2" Text="&#x276F; " FontWeight="Bold"/>
                                <Run Tag="fg" Text="ls"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview3" FontFamily="Consolas">
                                <Run Tag="c2" Text="drwxr-xr-x"/>
                                <Run Tag="fg" Text="  -  "/>
                                <Run Tag="c3" Text="underfit"/>
                                <Run Tag="fg" Text="  "/>
                                <Run Tag="c4" Text="2 Oct 18:52"/>
                                <Run Tag="fg" Text="  "/>
                                <Run Tag="c4" Text="&#xF07B; .config"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview4" FontFamily="Consolas">
                                <Run Tag="fg" Text="-rw-r--r-- "/>
                                <Run Tag="c2" Text="165 "/>
                                <Run Tag="c3" Text="underfit"/>
                                <Run Tag="fg" Text="  "/>
                                <Run Tag="c4" Text="2 Oct 18:52"/>
                                <Run Tag="fg" Text="  &#xF15B; .wget-hsts"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview5" FontFamily="Consolas">
                                <Run Tag="c3" Text="[~/projects]" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview6" FontFamily="Consolas">
                                <Run Tag="c5" Text="&#xF126; main " FontWeight="Bold"/>
                                <Run Tag="c2" Text="&#x276F; " FontWeight="Bold"/>
                                <Run Tag="fg" Text="_"/>
                            </TextBlock>
                            <StackPanel x:Name="PnlPalette" Orientation="Horizontal" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnLookCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
            <Button x:Name="BtnLookApply" Content="APPLY" IsDefault="True" Command="{Binding ApplyCommand}"
                    Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
        </StackPanel>
    </Grid>
</views:ChromeWindow>

<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.Instance.AppearanceWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    xmlns:instance="clr-namespace:WslSquad.UI.Wpf.Views.Instance"
                    xmlns:loc="clr-namespace:WslSquad.Presentation.Localization;assembly=wsl-squad.Presentation"
                    Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[AppearanceTitle]}"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
                    <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelIconText]}"/>
                    <TextBox x:Name="TxtIconText" Text="{Binding IconText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding IconError}" Visibility="{Binding IconError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppDangerBrush}"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Top" Margin="14,0,0,0" Width="64" Height="64">
                    <Border x:Name="BrdTile" CornerRadius="13" Width="60" Height="60"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="#333333"/>
                    <TextBlock x:Name="TxtTile" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34"/>
                    <Image x:Name="ImgIconPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelIconColor]}"/>
                    <ComboBox ItemsSource="{Binding PairLabels}" SelectedIndex="{Binding PairIndex, Mode=TwoWay}" Margin="0,6,0,0"/>
                    <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelIconFile]}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ImagePath}" ToolTip="{Binding ImagePath}"
                                   Foreground="{DynamicResource AppMutedBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionUpload]}" Command="{Binding PickImageCommand}"/>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelFont]}"/>
                    <ComboBox ItemsSource="{Binding FontLabels}" SelectedIndex="{Binding FontIndex, Mode=TwoWay}" Margin="0,6,0,0"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AppMutedBrush}"
                               Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[FontsHint]}"/>
                    <TextBlock Margin="0,14,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelColourScheme]}"/>
                    <ComboBox ItemsSource="{Binding SchemeLabels}" SelectedIndex="{Binding SchemeIndex, Mode=TwoWay}" Margin="0,6,0,0"/>
                    <TextBlock Margin="0,14,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelPreview]}"/>
                    <Border x:Name="BrdPreview" Margin="0,6,0,0" Padding="8,6" CornerRadius="3"
                            Background="#0C0C0C" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtPreview1">
                                <Run Tag="{x:Static instance:PreviewInk.Colour3}" Text="[~/projects]" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview2">
                                <Run Tag="{x:Static instance:PreviewInk.Colour5}" Text="&#xF126; main " FontWeight="Bold"/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour2}" Text="&#x276F; " FontWeight="Bold"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="ls"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview3">
                                <Run Tag="{x:Static instance:PreviewInk.Colour2}" Text="drwxr-xr-x"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="  -  "/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour3}" Text="underfit"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="  "/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour4}" Text="2 Oct 18:52"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="  "/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour4}" Text="&#xF07B; .config"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview4">
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="-rw-r--r-- "/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour2}" Text="165 "/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour3}" Text="underfit"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="  "/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour4}" Text="2 Oct 18:52"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="  &#xF15B; .wget-hsts"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview5">
                                <Run Tag="{x:Static instance:PreviewInk.Colour3}" Text="[~/projects]" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtPreview6">
                                <Run Tag="{x:Static instance:PreviewInk.Colour5}" Text="&#xF126; main " FontWeight="Bold"/>
                                <Run Tag="{x:Static instance:PreviewInk.Colour2}" Text="&#x276F; " FontWeight="Bold"/>
                                <Run Tag="{x:Static instance:PreviewInk.Foreground}" Text="_"/>
                            </TextBlock>
                            <StackPanel x:Name="PnlPalette" Orientation="Horizontal" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionCancel]}" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionApply]}" IsDefault="True" Command="{Binding ApplyCommand}"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </Grid>
</views:ChromeWindow>

<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.Views.Instance.ArchiveWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="Archive instance"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}"
                   Text="The instance will be stopped before it is archived.&#10;Save your work before proceeding."/>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"
                   Visibility="{Binding TakenVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Text="An archive with this name exists: it will be replaced."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
            <Button Content="ARCHIVE" IsDefault="True" Command="{Binding ConfirmCommand}"
                    Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

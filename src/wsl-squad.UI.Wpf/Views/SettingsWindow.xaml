<views:ChromeWindow x:Class="WslSquad.UI.Wpf.Views.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WslSquad.UI.Wpf.Views"
                    xmlns:loc="clr-namespace:WslSquad.Presentation.Localization;assembly=wsl-squad.Presentation"
                    Title="{Binding Source={x:Static loc:Localizer.Instance}, Path=[SettingsTitle]}"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize"
                    Foreground="{DynamicResource AppForegroundBrush}">
    <views:ChromeWindow.Resources>
        <DataTemplate x:Key="ChoiceLabelTemplate">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
        <DataTemplate x:Key="LanguageLabelTemplate">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
    </views:ChromeWindow.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[SettingsHeading]}" FontWeight="SemiBold"/>
        <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
        <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[Language]}" FontWeight="SemiBold"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageLabelTemplate}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanLanguage}" Command="{Binding OpenLanguageCommand}" CommandParameter="{Binding SelectedLanguageCode}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipOpenLanguage]}"/>
                <Button Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" Command="{Binding UploadLanguageCommand}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipUploadLanguage]}"/>
                <Button Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanLanguage}" Command="{Binding ExportLanguageCommand}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipSaveLanguage]}"/>
                <Button Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanLanguage}" Command="{Binding DeleteLanguageCommand}" CommandParameter="{Binding SelectedLanguageCode}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDeleteLanguage]}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding LanguageError}" Visibility="{Binding LanguageError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
        <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelRootFolder]}" FontWeight="SemiBold"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Root}" IsEnabled="False"/>
            <Button Grid.Column="1" Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipEditWorkingFolder]}" Command="{Binding EditRootCommand}"/>
        </Grid>
        <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelWslConfig]}" FontWeight="SemiBold"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding WslConfigPath, Mode=OneWay}" IsEnabled="False"/>
            <Button Grid.Column="1" Command="{Binding WslConfigCommand}" Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipOpenWslConfig]}"/>
        </Grid>
        <TextBlock Text="{Binding ConfigError}" Visibility="{Binding ConfigError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
        <TextBlock Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[AppearanceTitle]}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelFontShort]}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding Fonts}" ItemTemplate="{StaticResource ChoiceLabelTemplate}" SelectedIndex="{Binding FontIndex, Mode=TwoWay}"/>
                <Button Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipUploadFont]}" Command="{Binding UploadFontCommand}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding Sizes}" ItemTemplate="{StaticResource ChoiceLabelTemplate}" SelectedIndex="{Binding SizeIndex, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" Margin="16,6,0,0"/>
        </Grid>
        <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelTheme]}"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Colours}" ItemTemplate="{StaticResource ChoiceLabelTemplate}" SelectedIndex="{Binding ColourIndex, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTheme}" Command="{Binding OpenThemeCommand}" CommandParameter="{Binding SelectedColour}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipOpenTheme]}"/>
                <Button Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" Command="{Binding UploadThemeCommand}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipUploadTheme]}"/>
                <Button Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTheme}" Command="{Binding ExportThemeCommand}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipSaveTheme]}"/>
                <Button Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTheme}" Command="{Binding DeleteThemeCommand}" CommandParameter="{Binding SelectedColour}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDeleteTheme]}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding ThemeError}" Visibility="{Binding ThemeError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
        <TextBlock Margin="0,12,0,0" Text="{Binding Source={x:Static loc:Localizer.Instance}, Path=[LabelPacksCatalog]}" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ComboBox ItemsSource="{Binding Packs}" ItemTemplate="{StaticResource ChoiceLabelTemplate}" SelectedIndex="{Binding PackIndex, Mode=TwoWay}"/>
            <Button Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" Command="{Binding OpenPackCommand}" IsEnabled="{Binding CanPack}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipOpenPackFolder]}"/>
            <Button Content="&#xF0C5;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" Command="{Binding DuplicatePackCommand}" IsEnabled="{Binding CanPack}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDuplicatePack]}"/>
            <Button Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" Command="{Binding DeletePackCommand}" IsEnabled="{Binding CanPack}" ToolTip="{Binding Source={x:Static loc:Localizer.Instance}, Path=[TooltipDeletePack]}"/>
        </StackPanel>
        <TextBlock Text="{Binding CatalogueError}" Visibility="{Binding CatalogueError, Converter={StaticResource StringVisibilityConverter}}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Source={x:Static loc:Localizer.Instance}, Path=[ActionClose]}" IsDefault="True" IsCancel="True" Command="{Binding CloseCommand}"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</views:ChromeWindow>

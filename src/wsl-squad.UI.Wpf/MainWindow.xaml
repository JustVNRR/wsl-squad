<views:ChromeWindow x:Class="wsl_squad.UI.Wpf.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:wsl_squad.UI.Wpf.Views"
                    Title="WSL SQUAD"
                    SizeToContent="WidthAndHeight"
                    WindowStartupLocation="CenterScreen"
                    MinHeight="240"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="WSL SQUAD" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}"/>
                <TextBlock Text="{Binding Root, StringFormat='Root: {0}'}" Foreground="{DynamicResource AppMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding AddCommand}" Content="&#xF067;" FontFamily="{DynamicResource IconFace}"
                    Margin="0,0,8,0" VerticalAlignment="Top"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    ToolTip="Add"/>
            <Button Grid.Column="2" Command="{Binding RefreshCommand}" IsEnabled="{Binding Free}" Content="&#xF021;" FontFamily="{DynamicResource IconFace}"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    ToolTip="Refresh"/>
            <Button Grid.Column="3" Command="{Binding SettingsCommand}" Content="&#xF013;" FontFamily="{DynamicResource IconFace}"
                    Margin="8,0,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    ToolTip="Settings"/>
            <Button Grid.Column="4" Command="{Binding ThemeCommand}" IsEnabled="{Binding CanToggleTheme}"
                    Content="{Binding ThemeGlyph}" ToolTip="{Binding ThemeTooltip}"
                    FontFamily="{DynamicResource IconFace}"
                    Margin="8,0,0,0" VerticalAlignment="Top"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
            <Button x:Name="BtnQuit" Grid.Column="5" Content="&#xF00D;" FontFamily="{DynamicResource IconFace}"
                    Margin="8,0,0,0" VerticalAlignment="Top" Click="OnQuit"
                    Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    ToolTip="Close"/>
        </Grid>

        <ListView x:Name="LstInstances" ItemsSource="{Binding Rows}" IsEnabled="{Binding Free}" Grid.Row="1"
                  Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppDividerBrush}"
                  Foreground="{DynamicResource AppForegroundBrush}"
                  AlternationCount="2" KeyboardNavigation.TabNavigation="Continue"
                  VirtualizingPanel.IsVirtualizing="False"
                  ScrollViewer.CanContentScroll="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}"/>
                    <GridViewColumn Header="Action" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Commands}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Glyph}" ToolTip="{Binding Tooltip}"
                                                    Command="{Binding Command}" CommandParameter="{Binding Parameter}"
                                                    Margin="0,0,4,0" Background="Transparent"
                                                    Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                                    FontFamily="{DynamicResource IconFace}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <ProgressBar Grid.Row="2" Height="4" Margin="0,10,0,0"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AppForegroundBrush}" Background="{DynamicResource AppInputBackgroundBrush}" BorderThickness="0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Busy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
    </Grid>
</views:ChromeWindow>
